# Copy to .env on the Cloud Studio instance. Never commit .env.
PROJECT_ROOT=/workspace/model-invocation

# Runtime topology
GPU_DEVICE=0
GPU_LOCK_FILE=/workspace/model-invocation/runtime/gpu.lock
JOB_LOCK_FILE=/workspace/model-invocation/runtime/job.lock
SHARED_JOBS_ROOT=/workspace/model-invocation/runtime/jobs
MODELS_ROOT=/workspace/model-invocation/runtime/models
REPOS_ROOT=/workspace/model-invocation/runtime/repos
VENVS_ROOT=/workspace/model-invocation/runtime/venvs
LOG_ROOT=/workspace/model-invocation/runtime/logs
PID_ROOT=/workspace/model-invocation/runtime/pids

VISION_URL=http://127.0.0.1:8001
TTS_URL=http://127.0.0.1:8002
VIDEO_URL=http://127.0.0.1:8003
SERVICE_REQUEST_TIMEOUT_SECONDS=9000

# Digital personality: SiliconFlow OpenAI-compatible API
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
PERSONALITY_MODEL=Qwen/Qwen3-8B
PERSONALITY_PROVIDER=siliconflow
PERSONALITY_TIMEOUT_SECONDS=120
PERSONALITY_TEMPERATURE=0.7
PERSONALITY_MAX_TOKENS=700
PERSONALITY_MAX_REPLY_CHARS=60
PERSONALITY_ALLOW_FALLBACK=1

# Vision
VISION_BASE_MODEL=/workspace/model-invocation/runtime/models/stable-diffusion-xl-base-1.0
VISION_BASE_CHECKPOINT=/workspace/model-invocation/runtime/models/realvisxl-v5.0/RealVisXL_V5.0_fp16.safetensors
VISION_CONTROLNET=/workspace/model-invocation/runtime/models/controlnet-openpose-sdxl-1.0
VISION_IP_ADAPTER=/workspace/model-invocation/runtime/models/IP-Adapter-FaceID
VISION_IP_WEIGHT=ip-adapter-faceid_sdxl.bin
VISION_INSIGHTFACE_ROOT=/workspace/model-invocation/runtime/models/insightface
VISION_WIDTH=832
VISION_HEIGHT=1216
VISION_STEPS=28
VISION_GUIDANCE=5.0
VISION_CONTROL_SCALE=0.65
VISION_IP_SCALE=0.72
VISION_KEEP_WARM=0
VISION_CPU_OFFLOAD=0
VISION_ATTENTION_SLICING=1

# TTS
TTS_MODEL=/workspace/model-invocation/runtime/models/Fun-CosyVoice3-0.5B-2512
TTS_REPO=/workspace/model-invocation/runtime/repos/CosyVoice
TTS_FP16=1
TTS_KEEP_WARM=0
TTS_INSTRUCT_PREFIX="You are a helpful assistant."
TTS_MAX_TEXT_CHARS=2000

# Video: EchoMimicV3 Flash Pro
ECHOMIMIC_REPO=/workspace/model-invocation/runtime/repos/echomimic_v3
ECHOMIMIC_MODEL_ROOT=/workspace/model-invocation/runtime/models/EchoMimicV3/echomimicv3-flash-pro
ECHOMIMIC_BASE_MODEL=/workspace/model-invocation/runtime/models/Wan2.1-Fun-V1.1-1.3B-InP
ECHOMIMIC_WAV2VEC=/workspace/model-invocation/runtime/models/chinese-wav2vec2-base
VIDEO_FPS=25
VIDEO_MAX_FRAMES=81
VIDEO_MAX_SEGMENTS=3
VIDEO_STEPS=8
VIDEO_SAMPLE_SIZE=768
VIDEO_TIMEOUT_SECONDS=7200
VIDEO_PROMPT="A person is speaking naturally, full body visible head to toe, subtle natural head movement and restrained gestures."
VIDEO_GUIDANCE_SCALE=6.0
VIDEO_AUDIO_GUIDANCE_SCALE=3.0
VIDEO_TEACACHE_THRESHOLD=0.1

# Job retention and operational limits
JOB_RETENTION_DAYS=7
MAX_IMAGE_MB=20
MAX_AUDIO_MB=50
MAX_TEXT_CHARS=2000

# Host limits
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
TOKENIZERS_PARALLELISM=false
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
